# Copy to .env for the deprecated code/*.sh workflow, or export the ENVAULT_*
# variables below for the envault CLI. Do not commit .env.

# --- envault CLI (preferred) ---
ENVAULT_KEY_ID=alias/envault
ENVAULT_BUCKET=your-encrypted-files-bucket
ENVAULT_TABLE=envault-state
ENVAULT_REGION=us-east-1
# Required for decrypt, exec, and rotate-key
ENVAULT_ALLOWED_ACCOUNT_IDS=123456789012
# Optional. Days to retain DynamoDB audit events (default 365)
# ENVAULT_AUDIT_TTL_DAYS=365

# --- Legacy shell scripts (code/encrypt.sh, code/decrypt.sh) ---
AWS_PROFILE=default
AWS_REGION=us-east-1
S3_BUCKET=your-encrypted-files-bucket
KMS_KEY_ALIAS=alias/s3_key
# 12-digit account ID required by decrypt.sh discovery filter
KMS_ACCOUNT_ID=123456789012
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/your-key-id-here
ENCRYPTION_CONTEXT=purpose=backup
